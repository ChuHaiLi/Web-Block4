{
  "name": "student-management-csr",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/run-browser.mjs",
    "evidence:capture": "node tests/evidence.mjs",
    "backend": "node server/index.js",
    "start": "node server/index.js",
    "test:unit": "node --test tests/student.test.js",
    "test:api": "node --test tests/api.test.js",
    "test:browser:dev": "node tests/browser.mjs dev",
    "test:browser:production": "node tests/browser.mjs production",
    "test:e2e": "node tests/persistence.mjs",
    "evidence:state": "node tests/observe-state.mjs"
  },
  "dependencies": {
    "express": "5.2.1",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "playwright": "1.57.0",
    "vite": "7.3.6"
  }
}
